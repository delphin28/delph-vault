# PostgreSQL settings used by docker-compose.yaml
POSTGRES_DB=DelphVault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-database-password

# Used when running the backend outside Docker
DATABASE_URL=postgresql+psycopg://postgres:replace-with-a-strong-database-password@localhost:5432/DelphVault

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
SEED_DEMO_DATA=false
SQLALCHEMY_ECHO=false

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
VAULT_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Use true behind the HTTPS nginx service; false only for direct local HTTP development.
COOKIE_SECURE=true

# Comma-separated browser origins. Production should contain only trusted HTTPS origins.
CORS_ALLOWED_ORIGINS=https://localhost:8443

# Used by the frontend when running outside Docker. Compose sets this to /api.
REACT_APP_API_URL=http://localhost:8000
